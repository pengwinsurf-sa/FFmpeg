      <memberdef kind="variable" id="structAVClass_1a44dca198ce11fcd2a2b7488a927e4a46" prot="public" static="no" mutable="no">
        <type>const struct <ref refid="structAVClass" kindref="compound">AVClass</ref> *(*</type>
        <definition>const struct AVClass *(* AVClass::child_class_iterate) (void **iter)</definition>
        <argsstring>)(void **iter)</argsstring>
        <name>child_class_iterate</name>
        <qualifiedname>AVClass::child_class_iterate</qualifiedname>
        <briefdescription>
<para>Iterate over the AVClasses corresponding to potential AVOptions-enabled children. </para>
        </briefdescription>
        <detaileddescription>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>iter</parametername>
</parameternamelist>
<parameterdescription>
<para>pointer to opaque iteration state. The caller must initialize *iter to NULL before the first call. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para><ref refid="structAVClass" kindref="compound">AVClass</ref> for the next AVOptions-enabled child or NULL if there are no more such children.</para>
</simplesect>
<simplesect kind="note"><para>The difference between <ref refid="structAVClass_1a1d3701397a31766376ab4155b2a56451" kindref="member">child_next()</ref> and <ref refid="structAVClass_1a44dca198ce11fcd2a2b7488a927e4a46" kindref="member">child_class_iterate()</ref> is that <ref refid="structAVClass_1a1d3701397a31766376ab4155b2a56451" kindref="member">child_next()</ref> iterates over <emphasis>actual</emphasis> children of an <emphasis>existing</emphasis> object instance, while <ref refid="structAVClass_1a44dca198ce11fcd2a2b7488a927e4a46" kindref="member">child_class_iterate()</ref> iterates over the classes of all <emphasis>potential</emphasis> children of any possible instance of this class. </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="libavutil/log.h" line="150" column="5" bodyfile="libavutil/log.h" bodystart="167" bodyend="-1"/>
