        <briefdescription>
<para>Unmap or free the buffer bufptr created by <ref refid="file_8h_1ade51c2ba717b70fab329362952906cfe" kindref="member">av_file_map()</ref>. </para>
        </briefdescription>
        <detaileddescription>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>bufptr</parametername>
</parameternamelist>
<parameterdescription>
<para>the buffer previously created with <ref refid="file_8h_1ade51c2ba717b70fab329362952906cfe" kindref="member">av_file_map()</ref> </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>size</parametername>
</parameternamelist>
<parameterdescription>
<para>size in bytes of bufptr, must be the same as returned by <ref refid="file_8h_1ade51c2ba717b70fab329362952906cfe" kindref="member">av_file_map()</ref> </para>
</parameterdescription>
</parameteritem>
</parameterlist>
</para>
        </detaileddescription>
