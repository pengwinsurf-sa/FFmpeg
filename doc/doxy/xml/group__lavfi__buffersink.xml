      <memberdef kind="define" id="group__lavfi__buffersink_1gade670e86ece8d740194c916fa1ea6cc0" prot="public" static="no">
        <name>AV_BUFFERSINK_FLAG_NO_REQUEST</name>
        <initializer>2</initializer>
        <briefdescription>
<para>Tell av_buffersink_get_buffer_ref() not to request a frame from its input. </para>
        </briefdescription>
        <detaileddescription>
<para>If a frame is already buffered, it is read (and removed from the buffer), but if no frame is present, return <ref refid="group__lavu__error_1gae4bb6f165973d09584e0ec0f335f69ca" kindref="member">AVERROR(EAGAIN)</ref>. </para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="libavfilter/buffersink.h" line="91" column="9" bodyfile="libavfilter/buffersink.h" bodystart="91" bodyend="-1"/>
      </memberdef>
