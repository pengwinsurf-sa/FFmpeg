        <argsstring>(AVContainerFifo *cf, void **pobj, size_t offset)</argsstring>
        <name>av_container_fifo_peek</name>
        <param>
          <type><ref refid="container__fifo_8h_1a4be45c99f003c104eee68d05610434f3" kindref="member">AVContainerFifo</ref> *</type>
