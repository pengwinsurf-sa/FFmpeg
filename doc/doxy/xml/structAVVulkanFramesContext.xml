      <memberdef kind="variable" id="structAVVulkanFramesContext_1a1d59cf40209ed27b210f8b755c0250fa" prot="public" static="no" mutable="no">
        <type>VkImageTiling</type>
        <definition>VkImageTiling AVVulkanFramesContext::tiling</definition>
        <argsstring></argsstring>
        <name>tiling</name>
        <qualifiedname>AVVulkanFramesContext::tiling</qualifiedname>
        <briefdescription>
<para>Controls the tiling of allocated frames. </para>
        </briefdescription>
        <detaileddescription>
<para>If left as VK_IMAGE_TILING_OPTIMAL (0), will use optimal tiling. Can be set to VK_IMAGE_TILING_LINEAR to force linear images, or VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT to force DMABUF-backed images. <simplesect kind="note"><para>Imported frames from other APIs ignore this. </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="libavutil/hwcontext_vulkan.h" line="217" column="19" bodyfile="libavutil/hwcontext_vulkan.h" bodystart="217" bodyend="-1"/>
