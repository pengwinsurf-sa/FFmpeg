<para><programlisting filename=".c"><codeline><highlight class="normal">uint8_t<sp/>*buf<sp/>=<sp/><ref refid="group__lavu__mem__funcs_1gaafef95f25208665371057f89fb5a11b8" kindref="member">av_malloc</ref>(16);</highlight></codeline>
